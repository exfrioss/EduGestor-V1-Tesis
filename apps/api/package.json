{
  "name": "@edugestor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --pretty false --force",
    "test": "vitest run",
    "bootstrap:root": "tsc -b --pretty false --force && node dist/commands/bootstrap-root.js",
    "bootstrap:authorization-catalog": "tsc -b --pretty false --force && node dist/commands/bootstrap-authorization-catalog.js",
    "bootstrap:hito1-demo": "tsc -b --pretty false --force && node dist/commands/bootstrap-hito1-demo.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@edugestor/shared": "1.0.0",
    "@prisma/client": "6.12.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}
