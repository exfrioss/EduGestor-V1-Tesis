generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  STANDARD
  TECHNICAL
}

enum ScopeKind {
  INSTITUTION
  COURSE_SET
  RESOURCE_SET
}

enum AuditActorKind {
  USER
  TECHNICAL
  PROCESS
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ActivityBankKind {
  TASK
  INSTRUMENT
}

enum ScoringKind {
  ORDINARIA
  FUERA_DE_ESCALA
}

enum AssessmentResultStatus {
  PENDIENTE
  EVALUADO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  LLEGADA_TARDIA
  SALIDA_ANTICIPADA
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  login           String      @db.Text
  loginNormalized String      @unique @db.Text
  passwordHash    String      @db.Text
  accountKind     AccountKind @default(STANDARD)
  isActive        Boolean     @default(true)
  disabledAt      DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  rowVersion      Int         @default(1)

  authSessions              AuthSession[]
  teacher                   Teacher?
  roleAssignments           RoleAssignment[]           @relation("RoleAssignmentUser")
  assignmentsGranted        RoleAssignment[]           @relation("RoleAssignmentGrantedBy")
  assignmentsRevoked        RoleAssignment[]           @relation("RoleAssignmentRevokedBy")
  accessScopesCreated       AccessScope[]              @relation("AccessScopeCreatedBy")
  permissionsDelegated      RoleAssignmentPermission[] @relation("PermissionDelegatedBy")
  institutionsDisabled      Institution[]              @relation("InstitutionDisabledBy")
  teachersDisabled          Teacher[]                  @relation("TeacherDisabledBy")
  coursesDisabled           Course[]                   @relation("CourseDisabledBy")
  subjectsDisabled          Subject[]                  @relation("SubjectDisabledBy")
  curriculumMappingsCreated SubjectCurriculumMapping[] @relation("CurriculumMappingCreatedBy")
  curriculumMappingsUpdated SubjectCurriculumMapping[] @relation("CurriculumMappingUpdatedBy")
  studentsDisabled         Student[]                  @relation("StudentDisabledBy")
  tasksCreated             Task[]                     @relation("TaskCreatedBy")
  assessmentsCreated       Assessment[]               @relation("AssessmentCreatedBy")
  resultsEvaluated         AssessmentResult[]         @relation("ResultEvaluatedBy")
  gradingScalesCreated     GradingScale[]             @relation("GradingScaleCreatedBy")
  attendanceSessionsCreated AttendanceSession[]       @relation("AttendanceSessionCreatedBy")
  attendanceRecordsCreated  AttendanceRecord[]        @relation("AttendanceRecordCreatedBy")
  auditLogs                 AuditLog[]                 @relation("AuditActor")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Text
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.Text
  name       String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  rowVersion Int      @default(1)

  assignments RoleAssignment[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  rowVersion  Int      @default(1)

  assignmentPermissions RoleAssignmentPermission[]
}

model AccessScope {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @db.Uuid
  kind          ScopeKind
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion    Int       @default(1)

  institution Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("AccessScopeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  courses     ScopeCourse[]
  assignments RoleAssignment[]

  @@index([institutionId])
  @@index([createdById])
}

model ScopeCourse {
  id        String   @id @default(uuid()) @db.Uuid
  scopeId   String   @db.Uuid
  courseId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  scope  AccessScope @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([scopeId, courseId])
  @@index([courseId])
}

model RoleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeId     String    @db.Uuid
  grantedById String    @db.Uuid
  revokedAt   DateTime? @db.Timestamptz(3)
  revokedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion  Int       @default(1)

  user        User                       @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role        Role                       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scope       AccessScope                @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  grantedBy   User                       @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy   User?                      @relation("RoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  permissions RoleAssignmentPermission[]

  @@index([userId, revokedAt])
  @@index([scopeId])
  @@index([grantedById])
}

model RoleAssignmentPermission {
  id               String    @id @default(uuid()) @db.Uuid
  roleAssignmentId String    @db.Uuid
  permissionId     String    @db.Uuid
  parentGrantId    String?   @db.Uuid
  delegatedById    String    @db.Uuid
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion       Int       @default(1)

  assignment  RoleAssignment             @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict)
  permission  Permission                 @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  parentGrant RoleAssignmentPermission?  @relation("PermissionDelegation", fields: [parentGrantId], references: [id], onDelete: Restrict)
  childGrants RoleAssignmentPermission[] @relation("PermissionDelegation")
  delegatedBy User                       @relation("PermissionDelegatedBy", fields: [delegatedById], references: [id], onDelete: Restrict)

  @@unique([roleAssignmentId, permissionId])
  @@index([parentGrantId])
  @@index([permissionId])
}

model Institution {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.Text
  isActive     Boolean   @default(true)
  disabledAt   DateTime? @db.Timestamptz(3)
  disabledById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion   Int       @default(1)

  disabledBy          User?                @relation("InstitutionDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  academicYears       AcademicYear[]
  courses             Course[]
  subjects            Subject[]
  teacherLinks        TeacherInstitution[]
  teachingAssignments TeachingAssignment[]
  gradingScales       GradingScale[]
  accessScopes        AccessScope[]
  auditLogs           AuditLog[]

  @@index([disabledById])
}

model AcademicYear {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @db.Uuid
  label         String   @db.Text
  startsOn      DateTime @db.Date
  endsOn        DateTime @db.Date
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  rowVersion    Int      @default(1)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  courses     Course[]
  enrollments Enrollment[]

  @@unique([institutionId, label])
  @@unique([id, institutionId])
  @@index([institutionId, startsOn])
}

model Teacher {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  displayName  String    @db.Text
  isActive     Boolean   @default(true)
  disabledAt   DateTime? @db.Timestamptz(3)
  disabledById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion   Int       @default(1)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  disabledBy   User?                @relation("TeacherDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  institutions TeacherInstitution[]
  assignments  TeachingAssignment[]
  bankItems    ActivityBankItem[]

  @@index([disabledById])
}

model TeacherInstitution {
  id            String    @id @default(uuid()) @db.Uuid
  teacherId     String    @db.Uuid
  institutionId String    @db.Uuid
  endedAt       DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion    Int       @default(1)

  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([teacherId, institutionId])
  @@index([institutionId, endedAt])
}

model Course {
  id             String    @id @default(uuid()) @db.Uuid
  institutionId  String    @db.Uuid
  academicYearId String    @db.Uuid
  grade          String    @db.Text
  section        String    @db.Text
  shift          String    @db.Text
  btiYear        Int?      @db.SmallInt
  isActive       Boolean   @default(true)
  disabledAt     DateTime? @db.Timestamptz(3)
  disabledById   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion     Int       @default(1)

  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  disabledBy          User?                @relation("CourseDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  scopeMemberships    ScopeCourse[]
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]

  @@unique([institutionId, academicYearId, grade, section, shift])
  @@unique([id, institutionId])
  @@unique([id, academicYearId])
  @@index([institutionId, isActive])
  @@index([academicYearId])
  @@index([disabledById])
}

model Subject {
  id             String    @id @default(uuid()) @db.Uuid
  institutionId  String    @db.Uuid
  name           String    @db.Text
  nameNormalized String    @db.Text
  isActive       Boolean   @default(true)
  disabledAt     DateTime? @db.Timestamptz(3)
  disabledById   String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion     Int       @default(1)

  institution         Institution                @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  disabledBy          User?                      @relation("SubjectDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  curriculumMappings  SubjectCurriculumMapping[]

  @@unique([institutionId, nameNormalized])
  @@unique([id, institutionId])
  @@index([institutionId, isActive])
  @@index([disabledById])
}

model Student {
  id                   String    @id @default(uuid()) @db.Uuid
  givenNames           String    @db.Text
  familyNames          String    @db.Text
  nationalId           String?   @db.Text
  nationalIdNormalized String?   @unique @db.Text
  isActive             Boolean   @default(true)
  disabledAt           DateTime? @db.Timestamptz(3)
  disabledById         String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion           Int       @default(1)

  disabledBy  User?        @relation("StudentDisabledBy", fields: [disabledById], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@index([familyNames, givenNames])
  @@index([disabledById])
}

model Enrollment {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @db.Uuid
  courseId       String   @db.Uuid
  academicYearId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course       Course       @relation(fields: [courseId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  assessmentResults AssessmentResult[]
  attendanceRecords AttendanceRecord[]

  @@unique([studentId, courseId, academicYearId])
  @@index([courseId, academicYearId])
  @@index([studentId, academicYearId])
}

model PlanType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.Text
  name       String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  rowVersion Int      @default(1)

  academicAreas AcademicArea[]
  disciplines   CurriculumDiscipline[]
}

model AcademicArea {
  id         String   @id @default(uuid()) @db.Uuid
  planTypeId String   @db.Uuid
  code       String   @db.Text
  name       String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  rowVersion Int      @default(1)

  planType    PlanType               @relation(fields: [planTypeId], references: [id], onDelete: Restrict)
  disciplines CurriculumDiscipline[]

  @@unique([planTypeId, code])
  @@unique([id, planTypeId])
}

model CurriculumDiscipline {
  id             String   @id @default(uuid()) @db.Uuid
  planTypeId     String   @db.Uuid
  academicAreaId String?  @db.Uuid
  code           String   @db.Text
  officialName   String   @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  rowVersion     Int      @default(1)

  planType     PlanType                   @relation(fields: [planTypeId], references: [id], onDelete: Restrict)
  academicArea AcademicArea?              @relation(fields: [academicAreaId, planTypeId], references: [id, planTypeId], onDelete: Restrict)
  mappings     SubjectCurriculumMapping[]

  @@unique([planTypeId, code])
  @@index([academicAreaId, planTypeId])
}

model SubjectCurriculumMapping {
  id                     String    @id @default(uuid()) @db.Uuid
  subjectId              String    @db.Uuid
  btiYear                Int       @db.SmallInt
  curriculumDisciplineId String    @db.Uuid
  retiredAt              DateTime? @db.Timestamptz(3)
  createdById            String    @db.Uuid
  updatedById            String    @db.Uuid
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion             Int       @default(1)

  subject              Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  curriculumDiscipline CurriculumDiscipline @relation(fields: [curriculumDisciplineId], references: [id], onDelete: Restrict)
  createdBy            User                 @relation("CurriculumMappingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User                 @relation("CurriculumMappingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([subjectId, btiYear, createdAt])
  @@index([curriculumDisciplineId])
  @@index([createdById])
  @@index([updatedById])
}

model TeachingAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  teacherId     String    @db.Uuid
  institutionId String    @db.Uuid
  courseId      String    @db.Uuid
  subjectId     String    @db.Uuid
  gradingScaleId String?  @db.Uuid
  endedAt       DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion    Int       @default(1)

  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradingScale GradingScale? @relation(fields: [gradingScaleId, institutionId], references: [id, institutionId], onDelete: Restrict)
  tasks       Task[]
  assessments Assessment[]
  attendanceSessions AttendanceSession[]

  @@unique([teacherId, courseId, subjectId])
  @@index([teacherId, endedAt])
  @@index([courseId, subjectId])
  @@index([institutionId])
  @@index([gradingScaleId])
}

model AttendanceSession {
  id                   String   @id @default(uuid()) @db.Uuid
  teachingAssignmentId String   @db.Uuid
  classDate            DateTime @db.Date
  createdById          String   @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  rowVersion           Int      @default(1)

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          User               @relation("AttendanceSessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  records            AttendanceRecord[]

  @@index([teachingAssignmentId, classDate])
}

model AttendanceRecord {
  id                       String           @id @default(uuid()) @db.Uuid
  attendanceSessionId      String           @db.Uuid
  enrollmentId             String           @db.Uuid
  status                   AttendanceStatus
  isJustified              Boolean          @default(false)
  justificationObservation String?          @db.Text
  observation              String?          @db.Text
  recordedById             String           @db.Uuid
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)
  rowVersion               Int              @default(1)

  session    AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  enrollment Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy User              @relation("AttendanceRecordCreatedBy", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([attendanceSessionId, enrollmentId])
  @@index([enrollmentId, attendanceSessionId])
}

model GradingScale {
  id                   String    @id @default(uuid()) @db.Uuid
  institutionId        String    @db.Uuid
  name                 String    @db.Text
  version              Int
  minimumGrade         Decimal   @db.Decimal(18, 6)
  maximumGrade         Decimal   @db.Decimal(18, 6)
  conversionDefinition Json      @db.JsonB
  roundingDefinition   Json      @db.JsonB
  lockedAt             DateTime? @db.Timestamptz(3)
  createdById          String    @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  rowVersion           Int       @default(1)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("GradingScaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignments TeachingAssignment[]

  @@unique([institutionId, name, version])
  @@unique([id, institutionId])
  @@index([institutionId, name, version])
}

model ActivityBankItem {
  id                 String           @id @default(uuid()) @db.Uuid
  ownerTeacherId     String           @db.Uuid
  kind               ActivityBankKind
  title              String           @db.Text
  description        String           @db.Text
  instrumentContent  String?          @db.Text
  scoringKind        ScoringKind
  suggestedMaxPoints Decimal?         @db.Decimal(12, 4)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  rowVersion         Int              @default(1)

  ownerTeacher Teacher      @relation(fields: [ownerTeacherId], references: [id], onDelete: Restrict)
  sourceTasks  Task[]
  sourceAssessments Assessment[]

  @@index([ownerTeacherId, kind])
}

model Task {
  id                   String      @id @default(uuid()) @db.Uuid
  teachingAssignmentId String      @db.Uuid
  title                String      @db.Text
  description          String      @db.Text
  maxPoints            Decimal     @db.Decimal(12, 4)
  scoringKind          ScoringKind
  sourceBankItemId     String?     @db.Uuid
  sourceTaskId         String?     @db.Uuid
  createdById          String      @db.Uuid
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  rowVersion           Int         @default(1)

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  sourceBankItem     ActivityBankItem?   @relation(fields: [sourceBankItemId], references: [id], onDelete: Restrict)
  sourceTask         Task?               @relation("TaskCopies", fields: [sourceTaskId], references: [id], onDelete: Restrict)
  copies             Task[]              @relation("TaskCopies")
  createdBy          User                @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assessment         Assessment?

  @@index([teachingAssignmentId, createdAt])
  @@index([sourceBankItemId])
  @@index([sourceTaskId])
}

model Assessment {
  id                    String       @id @default(uuid()) @db.Uuid
  teachingAssignmentId  String       @db.Uuid
  title                 String       @db.Text
  description           String?      @db.Text
  taskId                String?      @unique @db.Uuid
  sourceBankItemId      String?      @db.Uuid
  sourceAssessmentId    String?      @db.Uuid
  instrumentContent     String?      @db.Text
  standaloneMaxPoints   Decimal?     @db.Decimal(12, 4)
  standaloneScoringKind ScoringKind?
  createdById           String       @db.Uuid
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)
  rowVersion            Int          @default(1)

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  task               Task?              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceBankItem     ActivityBankItem?   @relation(fields: [sourceBankItemId], references: [id], onDelete: Restrict)
  sourceAssessment   Assessment?        @relation("AssessmentCopies", fields: [sourceAssessmentId], references: [id], onDelete: Restrict)
  copies             Assessment[]       @relation("AssessmentCopies")
  createdBy          User               @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  results            AssessmentResult[]

  @@index([teachingAssignmentId, createdAt])
  @@index([sourceBankItemId])
  @@index([sourceAssessmentId])
}

model AssessmentResult {
  id           String                 @id @default(uuid()) @db.Uuid
  assessmentId String                 @db.Uuid
  enrollmentId String                 @db.Uuid
  status       AssessmentResultStatus
  earnedPoints Decimal?               @db.Decimal(12, 4)
  evaluatedAt  DateTime?              @db.Timestamptz(3)
  evaluatedById String?               @db.Uuid
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  rowVersion   Int                    @default(1)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  evaluatedBy User?      @relation("ResultEvaluatedBy", fields: [evaluatedById], references: [id], onDelete: Restrict)

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId, assessmentId])
  @@index([assessmentId, status])
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)
  actorUserId   String?        @db.Uuid
  actorKind     AuditActorKind
  action        String         @db.Text
  entityType    String         @db.Text
  entityId      String?        @db.Uuid
  institutionId String?        @db.Uuid
  outcome       AuditOutcome
  requestId     String         @db.Uuid
  reason        String?        @db.Text
  beforeData    Json?
  afterData     Json?
  details       Json?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  actor       User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([requestId])
}
