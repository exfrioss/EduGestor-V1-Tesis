# API
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://edugestor:edugestor_dev@localhost:5432/edugestor?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
SESSION_TTL_HOURS=8
SESSION_LAST_SEEN_INTERVAL_SECONDS=300
AUTH_COOKIE_NAME=edugestor_session
CSRF_COOKIE_NAME=edugestor_csrf
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Bootstrap raíz/técnico (obligatorio solo al ejecutar bootstrap:root)
# Definir en el entorno; nunca guardar credenciales reales en este archivo.
BOOTSTRAP_ROOT_LOGIN=
BOOTSTRAP_ROOT_PASSWORD=
BOOTSTRAP_ROOT_REASON=

# PostgreSQL local (solo valores de desarrollo)
POSTGRES_DB=edugestor
POSTGRES_USER=edugestor
POSTGRES_PASSWORD=edugestor_dev

# Frontend
VITE_API_URL=http://localhost:3000
